<% layout("/layouts/boilerplate") -%>

<main
  class="container my-5"
  style="max-width: 1040px; font-family: sans-serif; color: #222222"
>
  <!-- Breadcrumb Navigation -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol
      class="breadcrumb"
      style="font-size: 14px; background: none; padding: 0"
    >
      <li class="breadcrumb-item">
        <a href="#" class="text-secondary text-decoration-none">Home</a>
      </li>
      <li class="breadcrumb-item">
        <a href="#" class="text-secondary text-decoration-none">About us</a>
      </li>
      <li class="breadcrumb-item active text-dark" aria-current="page">
        Company Details
      </li>
    </ol>
  </nav>

  <!-- Two-Column Grid Row -->
  <div class="row g-5">
    <!-- Left Column: Company Corporate Details (col-md-8) -->
    <div class="col-md-8">
      <span class="text-muted small d-block mb-1">Corporate info</span>
      <h1 class="fw-bold mb-4" style="font-size: 2.3rem">Company Details</h1>

      <p class="fs-5 mb-4" style="line-height: 1.6; color: #484848">
        Airbnb operates an online platform facilitating connections between
        hosts offering accommodations and experiences and travelers seeking
        unique bookings worldwide.
      </p>

      <!-- Section 1: Global Parent Entity -->
      <section class="mb-5">
        <h3 class="fw-bold mb-3" style="font-size: 1.4rem">Airbnb, Inc.</h3>
        <p style="line-height: 1.6; color: #484848">
          The global operational parent platform for the service outside
          localized entities.
        </p>
        <table
          class="table table-borderless align-middle"
          style="color: #222222; font-size: 15px"
        >
          <tbody>
            <tr>
              <td class="text-muted ps-0" style="width: 35%">Headquarters:</td>
              <td class="fw-semibold">
                888 Brannan Street, San Francisco, CA 94103, USA
              </td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Founders:</td>
              <td class="fw-semibold">
                Brian Chesky, Nathan Blecharczyk, Joe Gebbia
              </td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Executive Leadership:</td>
              <td class="fw-semibold">
                Brian Chesky (CEO), Ahmad Al-Dahle (CTO)
              </td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Section 2: European and Global Bookings -->
      <section class="mb-5">
        <h3 class="fw-bold mb-3" style="font-size: 1.4rem">
          Airbnb Ireland Unlimited Company
        </h3>
        <p style="line-height: 1.6; color: #484848">
          Responsible for processing platform operations, customer compliance,
          and booking regulations for members throughout the international
          region.
        </p>
        <table
          class="table table-borderless align-middle"
          style="color: #222222; font-size: 15px"
        >
          <tbody>
            <tr>
              <td class="text-muted ps-0" style="width: 35%">
                Registered Address:
              </td>
              <td class="fw-semibold">
                The Watermarque Building, South Lotts Road, Ringsend, Dublin 4,
                Ireland
              </td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Registration Number:</td>
              <td class="fw-semibold">
                Companies Registration Office (CRO) No. 511825
              </td>
            </tr>
            <tr>
              <td class="text-muted ps-0">VAT Number:</td>
              <td class="fw-semibold">IE 9827384L</td>
            </tr>
          </tbody>
        </table>
      </section>

      <!-- Section 3: Indian Local Subsidiary Entity -->
      <section class="mb-5">
        <h3 class="fw-bold mb-3" style="font-size: 1.4rem">
          Airbnb India Private Limited
        </h3>
        <p style="line-height: 1.6; color: #484848">
          Local corporate arm handling specialized business activities and
          regional operational needs across the territory.
        </p>
        <table
          class="table table-borderless align-middle"
          style="color: #222222; font-size: 15px"
        >
          <tbody>
            <tr>
              <td class="text-muted ps-0" style="width: 35%">
                Registered Office:
              </td>
              <td class="fw-semibold">
                5th Floor, Caddie Commercial Tower, Aerocity, New Delhi, Delhi,
                110037, India
              </td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Corporate ID (CIN):</td>
              <td class="fw-semibold" style="font-family: monospace">
                U74900DL2012FTC232757
              </td>
            </tr>
            <tr>
              <td class="text-muted ps-0">Board of Directors:</td>
              <td class="fw-semibold">Anurag Gupta, Darrell Chan</td>
            </tr>
          </tbody>
        </table>
      </section>

      <hr class="my-5" style="border-top: 1px solid #dddddd" />

      <!-- Related Info Section -->
      <h2 class="fw-bold mb-4" style="font-size: 1.6rem">Related resources</h2>

      <div class="mb-4">
        <span class="text-muted small d-block mb-1">Legal terms</span>
        <a
          href="#"
          class="text-dark fw-bold d-block text-decoration-underline mb-1"
          >Terms of Service</a
        >
        <p class="text-secondary small">
          Review properties regarding mandatory country-specific provisions.
        </p>
      </div>

      <div class="mb-4">
        <span class="text-muted small d-block mb-1">Legal terms</span>
        <a
          href="#"
          class="text-dark fw-bold d-block text-decoration-underline mb-1"
          >Airbnb Privacy</a
        >
        <p class="text-secondary small">
          Understand how corporate entities securely handle and protect user
          profiles.
        </p>
      </div>
    </div>
  </div>
</main>

<!-- Reusable Bootstrap Modal for Feedback/Contact -->
<div
  class="modal fade"
  id="feedbackModal"
  tabindex="-1"
  aria-labelledby="feedbackModalLabel"
  aria-hidden="true"
>
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="border-radius: 12px">
      <div class="modal-header border-0 pb-0">
        <h5
          class="modal-title fw-bold"
          id="feedbackModalLabel"
          style="font-size: 1.5rem"
        >
          Corporate Help Feedback
        </h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <p class="text-secondary small mb-3">
          Send messages regarding corporate structures or registration profiles.
        </p>
        <form action="/feedback" method="POST">
          <div class="mb-3">
            <label for="feedbackMessage" class="form-label fw-semibold"
              >Message</label
            >
            <textarea
              class="form-control"
              id="feedbackMessage"
              name="message"
              rows="4"
              placeholder="How can our compliance desks assist you?"
              required
              style="border-radius: 8px"
            ></textarea>
          </div>
          <div class="d-flex justify-content-end gap-2 mt-4">
            <button
              type="button"
              class="btn btn-light border fw-bold px-4"
              data-bs-dismiss="modal"
              style="border-radius: 8px"
            >
              Cancel
            </button>
            <button
              type="submit"
              class="btn btn-dark fw-bold px-4"
              style="border-radius: 8px"
            >
              Submit
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Back to top element -->
<div class="position-fixed bottom-0 end-0 m-4">
  <button
    class="btn btn-dark rounded-pill px-3 py-2 fw-bold"
    style="font-size: 14px"
  >
    ↑ Back to top
  </button>
</div>
