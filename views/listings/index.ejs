    <button>CREATE NEW Listings</button>
</form> -->
<style>
    #filters-container {
    display: flex;
    align-items: center;
    margin-top: 1rem;
    width: 100%;
}
#filters {
    display: flex;
    align-items: center;
    overflow-x: auto;
    white-space: nowrap;
    justify-content: space-between;
    scroll-behavior: smooth;
    flex-grow: 1; 
    max-width: 60%;
}

#filters::-webkit-scrollbar {
    display: none;
}
.filter{
    margin-right:40px;
}
.right-menu {
    margin-left: auto; 
    display: flex;
    align-items: center;
    gap: 0.5rem; /* Space between Filter button and Tax Toggle */
    padding-left: 20px; /* Buffer so icons don't touch the buttons */
}

/* Clean up the fixed widths so they stay responsive */
.tax-toggle {
    border: 1px solid #b0b0b0;
    border-radius: 12px;
    height: 3.2rem;
    display: flex;
    align-items: center;
    padding: 0 15px;
    font-size: 0.85rem;
    white-space: nowrap;
    width: auto;
    margin-left: 10px;
}
.filter-panel {
    cursor: pointer;
    gap: 8px;
}
.tax-info {
    display: none;
}
.filter a {
    color: black;
    text-decoration: none;
}

    
</style>

<div id="filters-container">
    <button id="prev-btn" onclick="scrollFilters('left')">
        <i class="fa-solid fa-chevron-left"></i>
    </button>

    <div id="filters">
        <div class="filter">
            <a class="filter <%= selectedCategory === 'Trending' ? 'active' : '' %>" 
               href="/listings?category=Trending<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Tiny homes' ? 'active' : '' %>" 
               href="/listings?category=Tiny%20homes<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-house-chimney-window"></i></div>
                <p>Tiny homes</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Lakefront' ? 'active' : '' %>" 
               href="/listings?category=Lakefront<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-water"></i></div>
                <p>Lakefront</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Cabins' ? 'active' : '' %>" 
               href="/listings?category=Cabins<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-cable-car"></i></div> 
                <p>Cabins</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Beach' ? 'active' : '' %>" 
               href="/listings?category=Beach<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-umbrella-beach"></i></div>
                <p>Beach</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Amazing Pools' ? 'active' : '' %>" 
               href="/listings?category=Amazing%20Pools<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-water-ladder"></i></div>
                <p>Amazing Pools</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'OMG!' ? 'active' : '' %>" 
               href="/listings?category=OMG!<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-brands fa-space-awesome"></i></div>
                <p>OMG!</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Surfing' ? 'active' : '' %>" 
               href="/listings?category=Surfing<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-sailboat"></i></div>
                <p>Surfing</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Iconic cities' ? 'active' : '' %>" 
               href="/listings?category=Iconic%20cities<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-city"></i></div>
                <p>Iconic cities</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Rooms' ? 'active' : '' %>" 
               href="/listings?category=Rooms<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-bed"></i></div>
                <p>Rooms</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Farms' ? 'active' : '' %>" 
               href="/listings?category=Farms<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-wheat-awn"></i></div>
                <p>Farms</p>
            </a>
        </div>

        <div class="filter">
            <a class="filter <%= selectedCategory === 'Camping' ? 'active' : '' %>" 
               href="/listings?category=Camping<%= (typeof currentSort !== 'undefined' && currentSort) ? '&sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </a>
        </div> 
    </div>

    <button id="next-btn" onclick="scrollFilters('right')">
        <i class="fa-solid fa-chevron-right"></i>
    </button>

    <div class="right-menu">
        <% if (typeof selectedCategory !== 'undefined' && selectedCategory) { %>
            <a href="/listings?<%= (typeof currentSort !== 'undefined' && currentSort) ? 'sort=' + currentSort : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>" class="btn btn-sm btn-outline-danger me-2">
                <i class="fa-solid fa-xmark"></i> Clear Category
            </a>
        <% } %>

        <div class="filter-panel">
            <div class="dropdown">
                <button class="btn btn-outline-secondary dropdown-toggle" type="button" id="filterDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fa-solid fa-sliders me-2"></i> Filters
                </button>
        
                <div class="dropdown-menu p-2" aria-labelledby="filterDropdown">
                    <a class="dropdown-item <%= (typeof currentSort !== 'undefined' && currentSort === 'asc') ? 'active' : '' %>" 
                       href="/listings?sort=asc<%= (typeof selectedCategory !== 'undefined' && selectedCategory) ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                        <i class="fa-solid fa-arrow-up-short-wide me-2"></i> Min price to Max price
                    </a>
                    <a class="dropdown-item <%= (typeof currentSort !== 'undefined' && currentSort === 'desc') ? 'active' : '' %>" 
                       href="/listings?sort=desc<%= (typeof selectedCategory !== 'undefined' && selectedCategory) ? '&category=' + encodeURIComponent(selectedCategory) : '' %><%= (typeof currentSearch !== 'undefined' && currentSearch) ? '&search=' + encodeURIComponent(currentSearch) : '' %>">
                        <i class="fa-solid fa-arrow-down-wide-short me-2"></i> Max price to Min price
                    </a>
                    <% if ((typeof currentSort !== 'undefined' && currentSort) || (typeof currentSearch !== 'undefined' && currentSearch) || (typeof selectedCategory !== 'undefined' && selectedCategory)) { %>
                        <li><hr class="dropdown-divider"></li>
                        <a class="dropdown-item text-danger" href="/listings">
                            <i class="fa-solid fa-rotate me-2"></i> Reset All
                        </a>
                    <% } %>
                </div>
            </div>
        </div>
        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>
</div>

<% if (allListings.length === 0) { %>
    <div class="alert alert-danger col-md-6 offset-md-3 text-center mt-5" role="alert">
        <i class="fa-solid fa-triangle-exclamation"></i> No listings found matching "<b><%= currentSearch %></b>". Try looking for something else!
        <br>
        <a href="/listings" class="btn btn-sm btn-outline-danger mt-3">View All Listings</a>
    </div>
<% } else { %>
    <div class="row row-cols-sm-1 row-cols-md-3 mt-4 ">
        <% for(let listing of allListings){ %>
            <div class="col">
                <a href="/listings/<%= listing._id%>" class="listing-link">
                <div class="card col listing-card" style="width: 20rem;">
                    <img 
                        src="<%= (listing.image && listing.image.url) ? listing.image.url : 'https://plus.unsplash.com/premium_photo-1711305682256-3b1874c923bd?w=1000&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxmZWF0dXJlZC1waG90b3MtZmVlZHw3Mnx8fGVufDB8fHx8fA%3D%3D' %>" 
                        class="card-img-top" 
                        alt="listing_image" 
                        style="height:20rem;"/>
                        <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text">
                            <%= listing.title %><br>
                            &#8377; <%= (listing.price || 0).toLocaleString("en-IN") %> / night
                            <i class="tax-info">&nbsp; &nbsp; +<%= listing.gst || 18 %>% GST</i>
                        </p>
                    </div>
                </div>
            </a>
            </div>
        <% } %>
    </div>
<% } %>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    
    taxSwitch.addEventListener("change", function() {
        let taxInfo = document.getElementsByClassName("tax-info");
        for (let info of taxInfo) {
            if (this.checked) {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });
</script>