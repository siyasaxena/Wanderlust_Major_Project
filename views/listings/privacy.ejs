<% layout("/layouts/boilerplate") -%>

<main
  class="container my-5"
  style="max-width: 1040px; font-family: sans-serif; color: #222222"
>
  <!-- Breadcrumb Navigation -->
  <nav aria-label="breadcrumb" class="mb-4">
    <ol
      class="breadcrumb"
      style="font-size: 14px; background: none; padding: 0"
    >
      <li class="breadcrumb-item">
        <a href="#" class="text-secondary text-decoration-none">Home</a>
      </li>
      <li class="breadcrumb-item">
        <a href="#" class="text-secondary text-decoration-none">All topics</a>
      </li>
      <li class="breadcrumb-item">
        <a href="#" class="text-secondary text-decoration-none">Legal Terms</a>
      </li>
      <li class="breadcrumb-item">
        <a href="#" class="text-secondary text-decoration-none"
          >Privacy Policy</a
        >
      </li>
      <li class="breadcrumb-item active text-dark" aria-current="page">
        Airbnb Privacy
      </li>
    </ol>
  </nav>

  <!-- Two-Column Grid Row -->
  <div class="row g-5">
    <!-- Left Column: Main Privacy Content (col-8) -->
    <div class="col-md-8">
      <span class="text-muted small d-block mb-1">Legal terms</span>
      <h1 class="fw-bold mb-4" style="font-size: 2.3rem">Airbnb Privacy</h1>

      <p class="fs-5 mb-4" style="line-height: 1.6; color: #484848">
        Our Privacy Policy explains what personal information we collect, how we
        use personal information, how personal information is shared, and
        privacy rights.
      </p>

      <div class="mb-4">
        <a href="#" class="text-dark fw-bold fs-5 text-decoration-none"
          >Privacy Policy</a
        >
      </div>

      <p class="mb-4" style="line-height: 1.6; color: #484848">
        Please review the supplemental privacy policies linked within the
        privacy policy documents, such as for certain Airbnb services, that may
        be applicable to you.
      </p>

      <h3 class="fw-bold mt-5 mb-3" style="font-size: 1.3rem">
        Supplemental Privacy Policy Documents
      </h3>

      <!-- Combined list from image_97fd98.png and image_97fdb8.png -->
      <ul class="lh-lg mb-5" style="padding-left: 20px; color: #222222">
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Outside the United States Privacy Supplement</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >United States Privacy Supplement</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Brazil Privacy Supplement</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >China Privacy Supplement</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Korea Privacy Supplement</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Colombia Privacy Supplement</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Türkiye Privacy Supplement</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none">Cookie Policy</a>
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Non-User DAC7 Privacy Notice</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Privacy Policy Supplement for Airbnb Creators</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Privacy Policy Supplement for the Airbnb-friendly Marketplace</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Privacy Policy Supplement for Enterprise Customers and Airbnb for
            Work</a
          >
        </li>
        <li>
          <a href="#" class="text-dark text-decoration-none"
            >Privacy Policy Supplement for Insurance</a
          >
        </li>
      </ul>

      <p class="mb-5" style="line-height: 1.6; color: #484848">
        <a href="/listings" class="text-dark fw-bold text-decoration-underline"
          >Airbnb.org</a
        >
        is a separate and independent entity from Airbnb, Inc. Access the
        <a href="/privacy" class="text-dark fw-bold text-decoration-underline"
          >Airbnb.org Privacy Policy</a
        >.
      </p>

      <hr class="my-5" style="border-top: 1px solid #dddddd" />

      <!-- Related Articles Section (image_97fdf5.png) -->
      <h2 class="fw-bold mb-4" style="font-size: 1.6rem">Related articles</h2>

      <!-- Article 1 -->
      <div class="mb-4">
        <span class="text-muted small d-block mb-1">Legal terms</span>
        <a
          href="/privacy"
          class="text-dark fw-bold d-block text-decoration-underline mb-1"
          >Privacy Policy</a
        >
        <p class="text-secondary small">Please review our Privacy Policy.</p>
      </div>
    </div>
  </div>
</main>
